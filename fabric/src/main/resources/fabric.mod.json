{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_url}/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.pockyl.inventorybackups.fabric.InventoryBackupsFabric"],
    "client": ["com.pockyl.inventorybackups.fabric.InventoryBackupsFabricClient"]
  },
  "mixins": ["inventorybackups.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "forgeconfigapiport": ">=21.1.0",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "accessories": "*",
    "luckperms": "*"
  }
}
